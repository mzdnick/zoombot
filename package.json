    "pino": "^10.3.1"
  },
  "devDependencies": {
    "@types/eventsource": "^1.1.15",
    "@types/humanize-duration": "^3.27.4",
    "@types/node": "^25.0.0",
    "pino-pretty": "^13.1.3",
