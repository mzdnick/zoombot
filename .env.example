# Discord bot token
DISCORD_TOKEN=

# Discord guild/server id
GUILD_ID=

# Channel ids used by the bot
IDENTIFICATION_CHANNEL_ID=
REPORT_BUTTON_CHANNEL_ID=
FORUM_CHANNEL_ID=
DEVELOPMENT_CHANNEL_ID=
ROUTES_CHANNEL_ID=

# Optional: donate channel id. When set, enables the report donate nudges
# (a link button on resolved reports and a subtle subtext on report submission).
DONATE_CHANNEL_ID=

# Role id assigned after a user completes nickname setup
VERIFIED_ROLE=

# Role id assigned to new members on join (removed after nickname setup)
PENDING_ROLE=

# Staff role id (required for report actions: assign, close, merge, split)
STAFF_ROLE=

# Optional: scholar role id. Grants access to the "Rename Thread" report action
# and nothing else. Leave blank to keep report actions staff-only.
SCHOLAR_ROLE=

# Wiki repository settings (used to build the wiki search index)
# Defaults: WIKI_REPO=StarPilot-Docs/docs
#           WIKI_CACHE_DIR=data/wiki
WIKI_REPO=
WIKI_CACHE_DIR=

# Main openpilot fork (owner/repo on github.com) used for the "newer commit"
# reopen gate on reports. Default: firestar5683/openpilot
# MAIN_REPO=firestar5683/openpilot

# SQLite file backing the persistent key/value store (survives restarts)
# Default: data/store.sqlite
# STORE_PATH=data/store.sqlite

# Replay clipper service
OP_REPLAY_CLIPPER_ENDPOINT=
OP_REPLAY_CLIPPER_API_KEY=
# OP_REPLAY_CLIPPER_MAX_DURATION=60
# OP_REPLAY_CLIPPER_ALLOW_FACE_SWAP=false

# Maximum file size for Discord uploads in MB (default: 25; Nitro-boosted servers support more)
# GUILD_MAX_FILE_MB=25

# LLM-based report thread titles (OpenAI-compatible chat-completions API).
# All three are optional; if any is unset the bot falls back to the built-in
# embedding heuristic for titles.
# OPENAI_ENDPOINT=https://openrouter.ai/api/v1
# OPENAI_API_KEY=
# OPENAI_MODEL=

# Report thread limits.
# MAX_ACTIVE_REPORTS: max simultaneously-active (non-closed) report threads per
# user; submitting beyond the limit is blocked. Default: 2

# DORMANT_CLOSE_DAYS: report threads with no activity for this many days are
# auto-closed. Default: 14
# MAX_ACTIVE_REPORTS=2
# DORMANT_CLOSE_DAYS=14

# Logging level (trace, debug, info, warn, error, fatal)
# Defaults to "debug" in development, "info" in production
# LOG_LEVEL=

# Konik (api.konik.ai) route support. Route validation/metadata reads are unauthenticated,
# so no token is needed. Only set this if you're pointing at a non-default/self-hosted instance.
# KONIK_API_BASE=https://api.konik.ai
